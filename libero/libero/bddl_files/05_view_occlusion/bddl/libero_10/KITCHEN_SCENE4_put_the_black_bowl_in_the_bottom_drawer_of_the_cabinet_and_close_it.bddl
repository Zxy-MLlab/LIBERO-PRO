(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the black bowl in the bottom drawer of the cabinet and close it)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_rack_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.11 -0.31 -0.09000000000000001 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0049999999999999975 -0.07500000000000001 0.055 -0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.175 0.025 -0.125 0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (top_region
          (:target wine_rack_1)
      )
      (perturb_occ_bottle_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.34 -0.3 -0.33 -0.29)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    wine_rack_1 - wine_rack
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    wine_bottle_1 - wine_bottle
    black_book_occluder_1 - black_book
  )

  (:obj_of_interest
    akita_black_bowl_1
    white_cabinet_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On wine_rack_1 kitchen_table_wine_rack_init_region)
    (Open white_cabinet_1_bottom_region)
    (On black_book_occluder_1 kitchen_table_perturb_occ_bottle_1_init_region)
  )

  (:goal
    (And (Close white_cabinet_1_bottom_region) (In akita_black_bowl_1 white_cabinet_1_bottom_region))
  )

  (:perturbation_config
    (:case view_occlusion)
    (:category view_occlusion)
    (:source_suite libero_10)
    (:source_task KITCHEN_SCENE4_put_the_black_bowl_in_the_bottom_drawer_of_the_cabinet_and_close_it)
    (:bddl_only true)
    (:detail stand_one_book_face_to_agentview_in_front_of_the_target_without_touching_goal_objects)
    (:lighting
      (:enabled false)
      (:mode none)
      (:ambient 1.0)
      (:diffuse 1.0)
      (:specular 1.0)
    )
    (:observation
      (:enabled false)
      (:mode none)
      (:brightness 1.0)
      (:sigma 0.0)
    )
    (:camera
      (:enabled false)
      (:mode none)
      (:name agentview)
      (:pos 0.0 0.0 0.0)
      (:quat 1.0 0.0 0.0 0.0)
    )
    (:runtime_move
      (:enabled false)
      (:mode none)
      (:object akita_black_bowl_1)
      (:step 0)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
    )
    (:object_appearance
      (:enabled false)
      (:mode none)
      (:targets white_cabinet_1)
      (:rgba 0.72 0.63 0.50 1.0)
      (:override_material_rgba false)
      (:disable_material_texture false)
      (:apply_visible_geom_rgba false)
    )
    (:object_placement
      (:enabled true)
      (:mode front_occlusion)
      (:reference akita_black_bowl_1)
      (:front_direction 1.0 0.0)
      (:avoid_targets white_cabinet_1)
      (:min_avoid_distance 0.08)
      (:targets black_book_occluder_1)
      (:offsets_xy (
        (0.080 0.000)
      ))
      (:target_quat 1.0 0.0 0.0 0.0)
      (:z_offset 0.000)
      (:mesh_scale 1.6 1.6 1.6)
      (:min_reference_distance 0.02)
      (:pin_targets true)
    )
    (:object_shape
      (:enabled false)
      (:mode none)
      (:target akita_black_bowl_1)
      (:mesh_scale 1.0 1.0 1.0)
    )
    (:initial_pose
      (:enabled false)
      (:mode none)
      (:target akita_black_bowl_1)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
      (:yaw 0.0)
    )
  )

)
