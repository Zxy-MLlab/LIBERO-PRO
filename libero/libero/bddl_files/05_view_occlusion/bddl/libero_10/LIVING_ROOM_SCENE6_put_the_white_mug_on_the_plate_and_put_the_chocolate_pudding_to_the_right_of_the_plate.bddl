(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the white mug on the plate and put the chocolate pudding to the right of the plate)
    (:regions
      (plate_left_region
          (:target living_room_table)
          (:ranges (
              (0.09999999999999999 -0.15000000000000002 0.2 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_right_region
          (:target living_room_table)
          (:ranges (
              (0.09999999999999999 0.05 0.2 0.15000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target living_room_table)
          (:ranges (
              (0.125 -0.025 0.175 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.125 -0.175 -0.07500000000000001 -0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (-0.07500000000000001 0.07500000000000001 -0.025 0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_init_region
          (:target living_room_table)
          (:ranges (
              (-0.225 -0.025 -0.17500000000000002 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (perturb_occ_bottle_1_init_region
          (:target living_room_table)
          (:ranges (
              (-0.34 -0.3 -0.33 -0.29)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
  )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
    chocolate_pudding_1 - chocolate_pudding
    black_book_occluder_1 - black_book
  )

  (:obj_of_interest
    plate_1
    chocolate_pudding_1
    porcelain_mug_1
  )

  (:init
    (On plate_1 living_room_table_plate_init_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_init_region)
    (On chocolate_pudding_1 living_room_table_chocolate_pudding_init_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_init_region)
    (On black_book_occluder_1 living_room_table_perturb_occ_bottle_1_init_region)
  )

  (:goal
    (And (On porcelain_mug_1 plate_1) (On chocolate_pudding_1 living_room_table_plate_right_region))
  )

  (:perturbation_config
    (:case view_occlusion)
    (:category view_occlusion)
    (:source_suite libero_10)
    (:source_task LIVING_ROOM_SCENE6_put_the_white_mug_on_the_plate_and_put_the_chocolate_pudding_to_the_right_of_the_plate)
    (:bddl_only true)
    (:detail stand_one_book_face_to_agentview_in_front_of_the_target_without_touching_goal_objects)
    (:lighting
      (:enabled false)
      (:mode none)
      (:ambient 1.0)
      (:diffuse 1.0)
      (:specular 1.0)
    )
    (:observation
      (:enabled false)
      (:mode none)
      (:brightness 1.0)
      (:sigma 0.0)
    )
    (:camera
      (:enabled false)
      (:mode none)
      (:name agentview)
      (:pos 0.0 0.0 0.0)
      (:quat 1.0 0.0 0.0 0.0)
    )
    (:runtime_move
      (:enabled false)
      (:mode none)
      (:object plate_1)
      (:step 0)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
    )
    (:object_appearance
      (:enabled false)
      (:mode none)
      (:targets plate_1)
      (:rgba 0.30 0.20 0.12 1.0)
      (:override_material_rgba false)
      (:disable_material_texture false)
      (:apply_visible_geom_rgba false)
    )
    (:object_placement
      (:enabled true)
      (:mode front_occlusion)
      (:reference plate_1)
      (:front_direction 1.0 0.0)
      (:avoid_targets chocolate_pudding_1)
      (:min_avoid_distance 0.08)
      (:targets black_book_occluder_1)
      (:offsets_xy (
        (0.080 0.000)
      ))
      (:target_quat 1.0 0.0 0.0 0.0)
      (:z_offset 0.000)
      (:mesh_scale 1.6 1.6 1.6)
      (:min_reference_distance 0.02)
      (:pin_targets true)
    )
    (:object_shape
      (:enabled false)
      (:mode none)
      (:target plate_1)
      (:mesh_scale 1.0 1.0 1.0)
    )
    (:initial_pose
      (:enabled false)
      (:mode none)
      (:target plate_1)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
      (:yaw 0.0)
    )
  )

)
