(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the yellow and white mug in the microwave and close it)
    (:regions
      (microwave_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.33999999999999997 0.01 0.36)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.025 0.025 0.025)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.125 -0.275 -0.07500000000000001 -0.225)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_front_region
          (:target kitchen_table)
          (:ranges (
              (-0.05 -0.3 0.05 -0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target microwave_1)
      )
      (heating_region
          (:target microwave_1)
      )
      (perturb_occ_bottle_1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.34 -0.3 -0.33 -0.29)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
  )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    white_yellow_mug_1 - white_yellow_mug
    black_book_occluder_1 - black_book
  )

  (:obj_of_interest
    white_yellow_mug_1
    microwave_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_init_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_init_region)
    (On microwave_1 kitchen_table_microwave_init_region)
    (Open microwave_1)
    (On black_book_occluder_1 kitchen_table_perturb_occ_bottle_1_init_region)
  )

  (:goal
    (And (In white_yellow_mug_1 microwave_1_heating_region) (Close microwave_1))
  )

  (:perturbation_config
    (:case view_occlusion)
    (:category view_occlusion)
    (:source_suite libero_10)
    (:source_task KITCHEN_SCENE6_put_the_yellow_and_white_mug_in_the_microwave_and_close_it)
    (:bddl_only true)
    (:detail stand_one_book_face_to_agentview_in_front_of_the_target_without_touching_goal_objects)
    (:lighting
      (:enabled false)
      (:mode none)
      (:ambient 1.0)
      (:diffuse 1.0)
      (:specular 1.0)
    )
    (:observation
      (:enabled false)
      (:mode none)
      (:brightness 1.0)
      (:sigma 0.0)
    )
    (:camera
      (:enabled false)
      (:mode none)
      (:name agentview)
      (:pos 0.0 0.0 0.0)
      (:quat 1.0 0.0 0.0 0.0)
    )
    (:runtime_move
      (:enabled false)
      (:mode none)
      (:object white_yellow_mug_1)
      (:step 0)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
    )
    (:object_appearance
      (:enabled false)
      (:mode none)
      (:targets microwave_1)
      (:rgba 0.72 0.63 0.50 1.0)
      (:override_material_rgba false)
      (:disable_material_texture false)
      (:apply_visible_geom_rgba false)
    )
    (:object_placement
      (:enabled true)
      (:mode front_occlusion)
      (:reference white_yellow_mug_1)
      (:front_direction 1.0 0.0)
      (:avoid_targets microwave_1)
      (:min_avoid_distance 0.08)
      (:targets black_book_occluder_1)
      (:offsets_xy (
        (0.080 0.000)
      ))
      (:target_quat 1.0 0.0 0.0 0.0)
      (:z_offset 0.000)
      (:mesh_scale 1.6 1.6 1.6)
      (:min_reference_distance 0.02)
      (:pin_targets true)
    )
    (:object_shape
      (:enabled false)
      (:mode none)
      (:target white_yellow_mug_1)
      (:mesh_scale 1.0 1.0 1.0)
    )
    (:initial_pose
      (:enabled false)
      (:mode none)
      (:target white_yellow_mug_1)
      (:delta_xy 0.0 0.0)
      (:min_delta_norm 0.0)
      (:yaw 0.0)
    )
  )

)
